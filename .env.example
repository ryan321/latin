# ── Database ──────────────────────────────────────────────────────────
# Local Postgres (development):
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/latin
# Neon (staging/production — use the pooled connection string):
#   DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/latin

# ── Auth ──────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string
# Public URL of this app (no trailing slash)
AUTH_URL=http://localhost:3040

# Bootstrap student account (used by npm run db:seed)
SEED_EMAIL=student@local.test
SEED_PASSWORD=latin-learn
SEED_NAME=Student

# ── OpenRouter / DeepSeek ─────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
# Confirm exact slug on openrouter.ai/models
DEFAULT_MODEL=deepseek/deepseek-v4-pro-0731
# Optional per-task overrides:
# GRADER_MODEL=
# TUTOR_MODEL=
# GENERATE_MODEL=

# Soft cap on AI-generated activities per lesson (per student)
GENERATION_MAX_PER_LESSON=12
